precision mediump float;

varying vec3 v_normal;
varying vec3 v_position;
varying vec2 v_texcoord;

uniform bool u_isSun;

uniform vec3 u_lightPosition; 
uniform vec3 u_color;

uniform sampler2D u_texture;
uniform bool u_useTexture;

void main() {
  
  vec3 normal = normalize(v_normal);
  vec3 lightDir = normalize(u_lightPosition - v_position);

  float distance = length(u_lightPosition - v_position);
  float attenuation = 1.0 / (1.0 + 0.02 * distance + 0.001 * distance * distance);

  float light = max(dot(normal, lightDir), 0.0);
  light *= attenuation;

  vec3 baseColor = u_color;

  if (u_useTexture) {
    baseColor = texture2D(u_texture, v_texcoord).rgb;
  }

  vec3 ambient = vec3(0.05, 0.05, 0.05); // más oscuro para notar la luz puntual

  if (u_isSun) {
    // El sol emite luz, no depende de iluminación
    gl_FragColor = vec4(baseColor * 1.5, 1.0);
  } else {
    gl_FragColor = vec4(baseColor * light + ambient * baseColor, 1.0);
  }
}